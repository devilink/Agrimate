{
  "name": "@agrimate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "openapi": "nest build && node dist/openapi.js",
    "pii:rotate": "tsx prisma/rotate-pii-key.ts",
    "demo:history": "nest build && node dist/demo-history.js"
  },
  "dependencies": {
    "@agrimate/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.800.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "pdfkit": "^0.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.14.0",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "17.11.0-beta.19",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
