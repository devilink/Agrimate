# Base URL of the Agrimate API, without a trailing slash and without /api/v1.
#
# "localhost" only means this computer. On a phone or emulator use one of these:
#   Android emulator:              http://10.0.2.2:4000
#   Physical phone on same Wi-Fi:  http://192.168.x.x:4000  (this computer's LAN IP)
#   Phone or emulator over adb:    run "adb reverse tcp:4000 tcp:4000" and "adb reverse tcp:9000 tcp:9000",
#                                  then http://localhost:4000 works
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
