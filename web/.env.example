# Agrimate: the only settings the app needs. Copy to .env.local for local runs; add the same names in
# Vercel > Project > Settings > Environment Variables for production.

# Supabase > Project Settings > API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
# The public key: "publishable" (sb_publishable_...) on new projects, "anon" on older ones. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The private key: "secret" (sb_secret_...) on new projects, "service_role" on older ones. Server only, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay > Account & Settings > API Keys. Use rzp_test_ keys until you go live.
# Leave all three empty to hide online payments; buyers then pay offline.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Webhooks: the secret you type when adding https://YOUR-DOMAIN/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Optional. Emails (comma-separated) that become admin the first time they sign in at /adminagri.
# The address must be confirmed first. Server only. Existing admins are unaffected if you remove an email.
# ADMIN_EMAILS=

# Optional. Your public address (e.g. https://agrimate.in), used for links in search results and when shared.
# On Vercel it defaults to the project's production domain, so you only need it for a custom setup.
# NEXT_PUBLIC_SITE_URL=
