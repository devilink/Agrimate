# Agrimate configuration. Everything here has a working local default, so no .env is needed for `docker compose up`.
# For local (non-Docker) API runs, copy to apps/api/.env.

DATABASE_URL=postgresql://agrimate:agrimate@localhost:5432/agrimate
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
QUEUES_ENABLED=true

# Required in production (the API refuses to boot without them). Use long random values.
JWT_SECRET=
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# --- Provider switches: each flips one integration from mock to real ---
PAYMENT_PROVIDER=mock          # mock | razorpay
MAPS_PROVIDER=mock             # mock | google
SMS_PROVIDER=mock              # mock | twilio | sns | msg91
KYC_PROVIDER=mock              # mock | cashfree
MARKET_DATA_PROVIDER=mock      # mock | agmarknet
STORAGE_PROVIDER=s3            # s3 (MinIO locally) | mock

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_GATEWAY_FEE_BPS=150

# Google Maps
GOOGLE_MAPS_API_KEY=

# SMS (set whichever provider is chosen)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_DEFAULT_TEMPLATE=
# SNS also needs `pnpm --filter @agrimate/api add @aws-sdk/client-sns` and standard AWS credentials.

# KYC
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Market data
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Storage. S3_PUBLIC_ENDPOINT is the host that browsers and phones can reach; on a phone use your LAN IP.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=agrimate
S3_REGION=ap-south-1
S3_ACCESS_KEY=agrimate
S3_SECRET_KEY=agrimate-secret
