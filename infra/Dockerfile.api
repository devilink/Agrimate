# API image. Build context is the monorepo root. Migrates and seeds on start, so `docker compose up` works from empty.
# Defaults to production: mock bank, time travel and OTP echo are off, and demo logins are not seeded. Compose opts into development.
FROM node:22-slim AS base
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@11.15.0

FROM base AS build
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @agrimate/api... --filter agrimate
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN pnpm --filter @agrimate/shared build && pnpm --filter @agrimate/api build

FROM build AS runtime
WORKDIR /repo/apps/api
ENV NODE_ENV=production
EXPOSE 4000
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm run seed && node dist/main.js"]
